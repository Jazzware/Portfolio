---
// Experiencia como columna estratigráfica: una capa por trabajo, grosor proporcional a los meses,
// la más reciente arriba. Al aparecer en pantalla las capas se depositan de abajo hacia arriba.
import { content, type Lang } from '../data/content';
import { experience } from '../data/experience';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang].experience;

const parse = (s: string) => { const [y, m] = s.split('-').map(Number); return new Date(y, m - 1, 1); };
const now = new Date();
const monthFmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-MX' : 'en-US', { month: 'short', year: 'numeric' });
const PX_PER_MONTH = 4.6;

const layers = experience.map((job, i) => {
  const from = parse(job.from);
  const to = job.to ? parse(job.to) : now;
  const months = Math.max(1, (to.getFullYear() - from.getFullYear()) * 12 + to.getMonth() - from.getMonth() + 1);
  return {
    ...job,
    months,
    lith: (i % 4) + 1,
    top: job.to ? String(to.getFullYear()) : t.present,
    dates: `${monthFmt.format(from)} – ${job.to ? monthFmt.format(to) : t.present}`,
    duration: t.duration(Math.floor(months / 12), months % 12),
    delay: (experience.length - 1 - i) * 220,
  };
});
const base = experience.length ? parse(experience[experience.length - 1].from).getFullYear() : null;
---
<ol class="strata" aria-label={t.title}>
  {layers.map((l) => (
    <li class="layer" style={`--h:${Math.round(l.months * PX_PER_MONTH)}px;--delay:${l.delay}ms`}>
      <span class="tick" aria-hidden="true">{l.top}</span>
      <div class:list={['band', `lith-${l.lith}`]} aria-hidden="true"></div>
      <div class:list={['entry', { pending: l.pending }]}>
        <h3>{l.role[lang]}</h3>
        <p class="company">{l.company}{l.place && <span class="muted">, {l.place}</span>}</p>
        <p class="dates muted">{l.dates} <span class="sep" aria-hidden="true">/</span> {l.duration}</p>
        {l.highlights[lang].length > 0 && (
          <ul>{l.highlights[lang].map((h) => <li>{h}</li>)}</ul>
        )}
        {l.stack && <p class="stack muted">{l.stack}</p>}
        {l.pending && <p class="badge">{lang === 'es' ? 'Dato de ejemplo: reemplazar con el CV' : 'Placeholder: replace with CV data'}</p>}
      </div>
    </li>
  ))}
  {base && <li class="floor" aria-hidden="true"><span class="tick">{base}</span></li>}
</ol>

<script>
  const column = document.querySelector<HTMLElement>('.strata');
  if (column && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rect = column.getBoundingClientRect();
    // Solo se anima si la columna todavía no está a la vista al cargar.
    if (rect.top > innerHeight) {
      column.dataset.anim = '';
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          column.classList.add('deposited');
          io.disconnect();
        }
      }, { threshold: 0.25 });
      io.observe(column);
    }
  }
</script>

<style>
  .strata { list-style: none; margin: 0; padding: 0; }
  .layer {
    display: grid;
    grid-template-columns: 64px 128px minmax(0, 1fr);
    min-height: max(var(--h), 150px);
  }
  .tick {
    font-size: 15px; font-weight: 620; color: var(--lutita);
    border-top: 1px solid var(--lutita);
    padding-top: 4px; margin-right: 12px;
    font-variant-numeric: tabular-nums;
  }
  .band {
    border-top: 1.5px solid var(--pizarra);
    border-left: 1.5px solid var(--pizarra);
    border-right: 1.5px solid var(--pizarra);
    transform-origin: bottom;
  }
  .layer:last-of-type .band { border-bottom: 1.5px solid var(--pizarra); }

  /* Litologías: arenisca (puntos), marga (líneas espaciadas), lutita (láminas finas), caliza (bloques). */
  .lith-1 {
    background:
      radial-gradient(circle, var(--trazo) 1.3px, transparent 1.8px) 0 0 / 11px 11px,
      radial-gradient(circle, var(--trazo) 1.3px, transparent 1.8px) 5.5px 5.5px / 11px 11px,
      var(--capa-1);
  }
  .lith-2 {
    background:
      repeating-linear-gradient(0deg, transparent 0 11px, var(--trazo) 11px 12.5px),
      var(--capa-2);
  }
  .lith-3 {
    background:
      repeating-linear-gradient(0deg, transparent 0 5px, var(--trazo) 5px 6px),
      var(--capa-3);
  }
  .lith-4 {
    background:
      repeating-linear-gradient(0deg, transparent 0 15px, var(--trazo) 15px 16.5px),
      repeating-linear-gradient(90deg, transparent 0 31px, var(--trazo) 31px 32.5px),
      var(--capa-4);
  }

  .entry { border-top: 1px solid var(--linea); padding: 14px 0 32px 32px; max-width: calc(var(--texto) + 32px); }
  .company { font-weight: 560; }
  .dates { font-size: 16px; margin-top: 2px; }
  .sep { margin: 0 4px; }
  .entry ul { list-style: disc; margin-top: 12px; padding-left: 1.1em; display: flex; flex-direction: column; gap: 6px; }
  .entry li::marker { color: var(--ocre); }
  .stack { margin-top: 12px; font-size: 15px; }
  .entry.pending h3, .entry.pending p:not(.badge), .entry.pending li { color: var(--lutita); }
  .badge { display: inline-block; margin-top: 14px; padding: 2px 10px; border: 1.5px dashed var(--ocre); border-radius: 6px; font-size: 14px; color: var(--lutita); }

  .floor { display: grid; grid-template-columns: 64px; }

  /* Depósito: cada capa crece desde su base, de la más antigua a la más reciente. */
  .strata[data-anim] .band { transform: scaleY(0); }
  .strata[data-anim] .entry { opacity: 0; }
  .strata.deposited .band { transform: none; transition: transform 700ms cubic-bezier(.2, .7, .2, 1) var(--delay); }
  .strata.deposited .entry { opacity: 1; transition: opacity 500ms ease calc(var(--delay) + 350ms); }

  @media (max-width: 640px) {
    .layer { grid-template-columns: 44px 52px minmax(0, 1fr); }
    .floor { grid-template-columns: 44px; }
    .tick { font-size: 13px; margin-right: 6px; }
    .entry { padding-left: 16px; }
  }
</style>
