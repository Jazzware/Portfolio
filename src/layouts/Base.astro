---
import '../styles/global.css';
import { content, type Lang } from '../data/content';
import { site } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const canonical = new URL(lang === 'es' ? '/' : '/en/', site.url);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL('/', site.url)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', site.url)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site.url)} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0A0A0C" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // .anima esconde lo que va a entrar con movimiento. Si el script de movimiento no llega a tiempo,
      // se retira sola y todo queda visible y quieto.
      (function (r) {
        r.classList.add('js', 'anima');
        setTimeout(function () { if (!r.dataset.movimiento) r.classList.remove('anima'); }, 2500);
      })(document.documentElement);
    </script>
  </head>
  <body>
    <slot />
    <script>import '../scripts/movimiento';</script>
  </body>
</html>
