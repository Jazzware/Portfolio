---
// Fig. 2: un nivel real de PaleoSharp montado como espécimen y rotulado con líneas guía (ilustración de campo).
// Los rótulos son HTML para que se lean a cualquier ancho; las guías, SVG sobre la captura.
import { Image } from 'astro:assets';
import { content, type Lang } from '../data/content';
import nivel from '../assets/paleosharp-yacimiento.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const f = content[lang].project.figure;
// Puntos señalados, en píxeles de la captura (960 × 460), en el mismo orden que los rótulos.
const blancos = [{ x: 272, y: 250 }, { x: 465, y: 232 }, { x: 808, y: 236 }];
const columnas = [0, 320, 640];
---
<figure class="especimen" data-traza>
  <div class="marco">
    <Image src={nivel} alt={f.alt} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 640px" loading="eager" />
    <svg class="guias" viewBox="0 0 960 460" aria-hidden="true" focusable="false">
      {blancos.map((b) => (
        <>
          <circle class="despues punto" cx={b.x} cy={b.y} r="6" />
          <path class="trazo guia" d={`M ${b.x} ${b.y} L ${b.x} 460`} />
        </>
      ))}
    </svg>
  </div>
  <svg class="codos" viewBox="0 0 960 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    {blancos.map((b, i) => <path class="codo despues" d={`M ${b.x} 0 L ${b.x} 12 L ${columnas[i] + 1} 12 L ${columnas[i] + 1} 24`} />)}
  </svg>
  <ol class="rotulos despues">
    {f.labels.map((l) => <li><b>{l.name}</b><span>{l.note}</span></li>)}
  </ol>
  <figcaption><b>{f.caption}</b> {f.text}</figcaption>
</figure>

<style>
  .especimen { min-width: 0; }
  .marco { position: relative; border: 1px solid var(--filete-fuerte); }
  .marco :global(img) { display: block; width: 100%; height: auto; }
  .guias { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .punto { fill: var(--hueso); stroke: var(--horno); stroke-width: 2; }
  .guia { stroke: var(--hueso); stroke-width: 2; }
  .codos { display: block; width: 100%; height: var(--e-3); overflow: visible; }
  .codo { fill: none; stroke: var(--hueso); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .rotulos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; font-size: var(--t-chico); line-height: 1.45; }
  .rotulos li { display: grid; align-content: start; padding: var(--e-1) var(--e-2) 0 0; }
  .rotulos b { font-weight: 600; color: var(--hueso); }
  .rotulos span { color: var(--hueso-2); }
  figcaption { margin-top: var(--e-3); }
</style>
