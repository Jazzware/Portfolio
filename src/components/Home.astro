---
// Página única del portafolio. Estructura: MASTER.md §8. Cada sección declara su mundo:
// cobalto (ingeniero) u óxido (creador). Los textos vienen de data/content.ts.
import { content, type Lang } from '../data/content';
import { site } from '../config';
import Jarra from './Jarra.astro';
import FiguraPaleo from './FiguraPaleo.astro';
import Vasija from './Vasija.astro';
import ContactForm from './ContactForm.astro';
import Excavacion from './Excavacion.astro';
import Avisos from './Avisos.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const cv = site.cv[lang];
const idiomas = [
  { code: 'es', label: 'ES', name: 'Español', href: '/' },
  { code: 'en', label: 'EN', name: 'English', href: '/en/' },
];
const secciones = [
  { id: 'paleosharp', label: t.nav.project },
  { id: 'experiencia', label: t.nav.experience },
  { id: 'herramientas', label: t.nav.skills },
  { id: 'contacto', label: t.nav.contact },
];
const enlaces = [
  site.email && { label: t.contact.email, href: `mailto:${site.email}`, text: site.email },
  site.linkedin && { label: t.contact.linkedin, href: site.linkedin, text: site.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') },
  site.github && { label: t.contact.github, href: site.github, text: site.github.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '') },
  cv && { label: t.contact.cv, href: cv, text: t.hero.cv },
].filter(Boolean) as { label: string; href: string; text: string }[];
const pilaLabel = t.experience.vessel.stack;
---
<a class="saltar" href="#main">{t.nav.skip}</a>

<header class="encabezado">
  <div class="wrap barra">
    <a class="marca" href={lang === 'es' ? '/' : '/en/'}>{site.name}</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu">{t.nav.menu}</button>
    <div class="menu" id="menu">
      <nav aria-label={t.nav.sections}>
        <ul>
          {secciones.map((s, i) => (
            <li><a href={`#${s.id}`}><span class="tecla" aria-hidden="true">{i + 1}</span>{s.label}</a></li>
          ))}
        </ul>
      </nav>
      <button class="atajos-btn" type="button" popovertarget="atajos" aria-label={t.shortcuts.button}>?</button>
      <div class="idiomas">
        {idiomas.map((l) => l.code === lang
          ? <span class="idioma actual" aria-hidden="true">{l.label}</span>
          : <a class="idioma" href={l.href} hreflang={l.code} lang={l.code} aria-label={l.name}>{l.label}</a>)}
      </div>
    </div>
  </div>
</header>

<div id="atajos" class="atajos" popover>
  <p class="atajos-titulo">{t.shortcuts.title}</p>
  <dl>
    {t.shortcuts.items.map(([k, label]) => <div><dt><kbd>{k}</kbd></dt><dd>{label}</dd></div>)}
  </dl>
  <button class="cerrar" type="button" popovertarget="atajos" popovertargetaction="hide">{t.shortcuts.close}</button>
</div>

<main id="main">
  <section class="portada mundo-ingeniero" aria-labelledby="portada-titulo">
    <div class="wrap portada-grid">
      <div class="portada-texto">
        <h1 id="portada-titulo" data-revela>{site.name}</h1>
        <p class="rol" data-revela>{t.hero.role}</p>
        <p class="lede" data-revela>{t.hero.lede}</p>
        <p class="busca" data-revela>{t.hero.seeking}</p>
        <p class="aficiones" data-revela>{t.hero.hobbies}</p>
        <div class="acciones" data-revela>
          <a class="btn" href="#contacto">{t.hero.contact}</a>
          <a class="btn mundo-creador" href={site.paleosharp.play}>{t.hero.play}</a>
          {cv && <a class="btn" href={cv} download>{t.hero.cv}</a>}
        </div>
      </div>
      <Jarra lang={lang} />
    </div>
  </section>

  <section id="paleosharp" class="seccion mundo-creador" aria-labelledby="paleosharp-titulo">
    <div class="wrap">
      <div class="cabeza paleo">
        <div class="paleo-texto">
          <h2 id="paleosharp-titulo" tabindex="-1" data-revela>{t.project.title}</h2>
          <p class="resumen" data-revela>{t.project.summary}</p>
          <p class="chico" data-revela>{t.project.scope}</p>
          <div class="acciones" data-revela>
            <a class="btn" href={site.paleosharp.play}>{t.project.play}</a>
            {site.paleosharp.source && <a class="btn" href={site.paleosharp.source}>{t.project.source}</a>}
          </div>
          <p class="chico" data-revela>{t.project.desktop}</p>
        </div>
        <FiguraPaleo lang={lang} />
      </div>
      <div class="dos-columnas como">
        <h3 data-revela>{t.project.howTitle}</h3>
        <div>
          <ul class="filas">{t.project.how.map((x) => <li data-revela>{x}</li>)}</ul>
          <p class="chico pila" data-revela>{pilaLabel}: {t.project.stack}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="experiencia" class="seccion mundo-ingeniero" aria-labelledby="experiencia-titulo">
    <div class="wrap">
      <div class="cabeza dos-columnas">
        <h2 id="experiencia-titulo" tabindex="-1" data-revela>{t.experience.title}</h2>
        <div>
          <h3 data-revela>{t.experience.practicesTitle}</h3>
          <ul class="filas practicas">{t.experience.practices.map((x) => <li data-revela>{x}</li>)}</ul>
        </div>
      </div>
      <div class="exp-cuerpo"><Vasija lang={lang} /></div>
    </div>
  </section>

  <section id="herramientas" class="seccion mundo-ingeniero" aria-labelledby="herramientas-titulo">
    <div class="wrap">
      <div class="cabeza"><h2 id="herramientas-titulo" tabindex="-1" data-revela>{t.skills.title}</h2></div>
      <div class="herr">
        <dl class="tabla">
          {t.skills.groups.map((g) => (
            <div class="fila" data-revela><dt>{g.name}</dt><dd><ul class="en-linea">{g.items.map((i) => <li>{i}</li>)}</ul></dd></div>
          ))}
        </dl>
        <dl class="tabla">
          {t.skills.education.map((g) => (
            <div class="fila" data-revela><dt>{g.name}</dt><dd><ul>{g.items.map((i) => <li>{i}</li>)}</ul></dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section id="contacto" class="seccion mundo-ingeniero" aria-labelledby="contacto-titulo">
    <div class="wrap">
      <div class="cabeza contacto">
        <div>
          <h2 id="contacto-titulo" tabindex="-1" data-revela>{t.contact.title}</h2>
          <p class="lede" data-revela>{t.contact.text}</p>
          {enlaces.length > 0 && (
            <>
              <p class="chico otros" data-revela>{t.contact.elsewhere}</p>
              <ul class="enlaces">
                {enlaces.map((l) => <li data-revela><span class="chico">{l.label}</span><a class="enlace" href={l.href}>{l.text}</a></li>)}
              </ul>
            </>
          )}
        </div>
        <div data-revela><ContactForm lang={lang} /></div>
      </div>
    </div>
  </section>
</main>

<footer class="pie">
  <div class="wrap">
    <Excavacion lang={lang} />
    <div class="pie-fila">
      <p class="pie-nombre">{site.name}</p>
      <p class="chico">{t.footer}</p>
    </div>
  </div>
</footer>

<Avisos lang={lang} />

<script>
  import { reducido } from '../scripts/movimiento';

  // Menú en pantallas angostas. Sin JavaScript las secciones siempre se ven.
  const boton = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('menu');
  if (boton && menu) {
    const abre = (si: boolean) => { boton.setAttribute('aria-expanded', String(si)); menu.classList.toggle('abierto', si); };
    boton.addEventListener('click', () => abre(boton.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) abre(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') { abre(false); boton.focus(); }
    });
  }

  // Atajos: 1 a 4 saltan entre secciones como un selector de niveles; ? muestra la lista.
  const atajos = document.getElementById('atajos');
  const destinos: Record<string, string> = { '1': 'paleosharp', '2': 'experiencia', '3': 'herramientas', '4': 'contacto' };
  document.addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.target instanceof Element && e.target.closest('input, textarea, select, [contenteditable]')) return;
    if (e.key === '?' && atajos) { e.preventDefault(); atajos.togglePopover(); return; }
    const id = destinos[e.key];
    if (!id) return;
    const seccion = document.getElementById(id);
    if (!seccion) return;
    e.preventDefault();
    seccion.scrollIntoView({ behavior: reducido() ? 'auto' : 'smooth', block: 'start' });
    seccion.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true });
  });
</script>

<style>
  /* ---------- Encabezado: opaco, con filete; sin vidrio ---------- */
  .encabezado {
    position: sticky; top: 0; z-index: var(--z-encabezado);
    background: var(--horno);
    border-bottom: 1px solid var(--filete);
  }
  .barra { display: flex; align-items: center; justify-content: space-between; gap: var(--e-2) var(--e-4); min-height: 72px; }
  .marca { color: var(--hueso); text-decoration: none; font-weight: 600; }
  .menu { display: flex; align-items: center; gap: var(--e-3); }
  nav ul { display: flex; gap: var(--e-1) var(--e-3); flex-wrap: wrap; }
  nav a {
    position: relative; display: inline-flex; align-items: center; gap: var(--e-1);
    min-height: 44px; color: var(--hueso); text-decoration: none; font-size: var(--t-chico); font-weight: 600;
  }
  nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: var(--e-1); height: 1px;
    background: var(--cobalto); transform: scaleX(0); transform-origin: left;
    transition: transform var(--d-base) var(--curva-exacta);
  }
  @media (hover: hover) and (pointer: fine) { nav a:hover::after { transform: scaleX(1); } }
  .tecla, kbd {
    display: inline-grid; place-items: center; min-width: var(--e-3); height: var(--e-3); padding: 0 var(--e-1);
    font: 600 var(--t-chico) / 1 var(--sans); color: var(--hueso-2); border: 1px solid var(--filete-fuerte);
  }
  .atajos-btn {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    font: 600 var(--t-chico) / 1 var(--sans); color: var(--hueso-2);
    background: none; border: 1px solid var(--filete-fuerte); cursor: pointer;
    transition: color var(--d-rapida) var(--curva-exacta), border-color var(--d-rapida) var(--curva-exacta);
  }
  @media (hover: hover) and (pointer: fine) { .atajos-btn:hover { color: var(--hueso); border-color: var(--hueso-2); } }
  .atajos-btn:active { color: var(--hueso); border-color: var(--hueso); }
  .idiomas { display: flex; border: 1px solid var(--filete-fuerte); }
  .idioma { display: grid; place-items: center; min-width: 44px; min-height: 44px; font-size: var(--t-chico); font-weight: 600; color: var(--hueso); text-decoration: none; }
  .idioma.actual { background: var(--hueso); color: var(--horno); }
  @media (hover: hover) and (pointer: fine) { a.idioma:hover { background: var(--placa); } }
  .menu-btn {
    display: none; min-height: 44px; padding: 0 var(--e-2);
    background: none; border: 1px solid var(--filete-fuerte); font-size: var(--t-chico); font-weight: 600; cursor: pointer;
  }
  @media (max-width: 860px) {
    .barra { flex-wrap: wrap; padding-block: var(--e-2); }
    .menu { flex-basis: 100%; flex-direction: column; align-items: flex-start; gap: var(--e-2); padding-bottom: var(--e-1); }
    nav ul { flex-direction: column; gap: 0; }
    nav a { min-height: 48px; font-size: var(--t-cuerpo); }
    .tecla, .atajos-btn { display: none; }
    :global(.js) .menu-btn { display: inline-flex; align-items: center; }
    :global(.js) .menu {
      transition: opacity var(--d-base) var(--curva-exacta), transform var(--d-base) var(--curva-exacta), display var(--d-base) allow-discrete;
    }
    :global(.js) .menu:not(.abierto) { display: none; opacity: 0; transform: translateY(4px); transition-duration: var(--d-salida); }
    @starting-style { :global(.js) .menu.abierto { opacity: 0; transform: translateY(8px); } }
  }

  /* ---------- Atajos de teclado (popover nativo) ---------- */
  .atajos {
    position: fixed; inset: auto var(--margen) auto auto; top: calc(72px + var(--e-1)); margin: 0;
    width: 280px; padding: var(--e-3);
    color: var(--hueso); background: var(--placa); border: 1px solid var(--filete-fuerte);
    opacity: 1; transform: none;
    transition: opacity var(--d-base) var(--curva-exacta), transform var(--d-base) var(--curva-exacta),
      display var(--d-base) allow-discrete, overlay var(--d-base) allow-discrete;
  }
  .atajos:not(:popover-open) { opacity: 0; transform: translateY(4px); transition-duration: var(--d-salida); }
  @starting-style { .atajos:popover-open { opacity: 0; transform: translateY(8px); } }
  .atajos-titulo { font-weight: 600; margin-bottom: var(--e-2); }
  .atajos dl div { display: grid; grid-template-columns: 40px 1fr; align-items: center; padding: var(--e-1) 0; border-top: 1px solid var(--filete); font-size: var(--t-chico); }
  .cerrar { margin-top: var(--e-2); min-height: 44px; padding: 0; background: none; border: 0; color: var(--cobalto); font-size: var(--t-chico); font-weight: 600; cursor: pointer; }

  /* ---------- Portada ---------- */
  .portada { padding-top: var(--e-12); }
  .portada-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--e-6); align-items: end; }
  h1 { font-size: var(--t-display); line-height: 1; letter-spacing: -0.025em; }
  .rol { margin-top: var(--e-3); font-size: var(--t-h3); line-height: 1.2; font-weight: 600; color: var(--mundo); }
  .lede { margin-top: var(--e-4); max-width: 60ch; }
  .busca { margin-top: var(--e-2); font-weight: 600; }
  .aficiones { margin-top: var(--e-2); max-width: 60ch; color: var(--hueso-2); }
  .portada .acciones { margin-top: var(--e-4); }
  @media (max-width: 900px) { .portada-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .portada { padding-top: var(--e-6); } }

  /* ---------- Cabeza de sección: filete en el color del mundo ---------- */
  .cabeza { border-top: 1px solid var(--mundo); padding-top: var(--e-4); }
  .dos-columnas { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--e-3) var(--e-6); align-items: start; }
  .filas li { padding: var(--e-2) 0; border-top: 1px solid var(--filete); max-width: 68ch; }
  .filas li:first-child { border-top: 0; padding-top: 0; }
  @media (max-width: 900px) { .dos-columnas { grid-template-columns: minmax(0, 1fr); } }

  /* ---------- PaleoSharp ---------- */
  .paleo { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--e-6); align-items: start; }
  .paleo-texto { display: grid; gap: var(--e-2); justify-items: start; }
  .paleo-texto h2 { margin-bottom: var(--e-1); }
  .paleo .acciones { margin-block: var(--e-1); }
  .como { margin-top: var(--e-12); }
  .como h3 { color: var(--mundo); }
  .pila { margin-top: var(--e-3); }
  @media (max-width: 900px) { .paleo { grid-template-columns: minmax(0, 1fr); } .como { margin-top: var(--e-8); } }

  /* ---------- Experiencia ---------- */
  .practicas { margin-top: var(--e-2); }
  .exp-cuerpo { margin-top: var(--e-12); }
  @media (max-width: 640px) { .exp-cuerpo { margin-top: var(--e-8); } }

  /* ---------- Herramientas y formación ---------- */
  .herr { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 0 var(--e-6); margin-top: var(--e-6); }
  .fila { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 5fr); gap: var(--e-1) var(--e-3); padding: var(--e-2) 0; border-top: 1px solid var(--filete); }
  dt { font-weight: 600; }
  .en-linea { display: flex; flex-wrap: wrap; }
  .en-linea li:not(:last-child)::after { content: ',\00a0'; }
  @media (max-width: 900px) { .herr { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .fila { grid-template-columns: minmax(0, 1fr); } }

  /* ---------- Contacto ---------- */
  .contacto { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--e-6) var(--e-8); align-items: start; }
  .contacto .lede { margin-top: var(--e-3); max-width: 44ch; }
  .otros { margin-top: var(--e-6); }
  .enlaces { margin-top: var(--e-1); border-top: 1px solid var(--filete); }
  .enlaces li { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: var(--e-2); align-items: baseline; padding: var(--e-2) 0; border-bottom: 1px solid var(--filete); }
  .enlaces a { overflow-wrap: anywhere; font-weight: 600; }
  @media (max-width: 900px) { .contacto { grid-template-columns: minmax(0, 1fr); } }

  /* ---------- Pie ---------- */
  .pie { margin-top: var(--e-16); padding-bottom: var(--e-6); }
  .pie-fila { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--e-1) var(--e-4); padding-top: var(--e-3); }
  .pie-nombre { font-weight: 600; }
</style>
