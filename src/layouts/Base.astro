---
import '../styles/global.css';
import { content, type Lang } from '../data/content';
import { site } from '../config';

interface Props {
  lang: Lang;
  /** Para páginas aparte de la portada (p. ej. /binder/): título, descripción y ruta propios, sin versión EN. */
  pagina?: { titulo: string; descripcion: string; ruta: string; indexar?: boolean };
}
const { lang, pagina } = Astro.props;
const t = content[lang];
const titulo = pagina?.titulo ?? t.meta.title;
const descripcion = pagina?.descripcion ?? t.meta.description;
const canonical = new URL(pagina?.ruta ?? (lang === 'es' ? '/' : '/en/'), site.url);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {pagina?.indexar === false && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {!pagina && <>
      <link rel="alternate" hreflang="es" href={new URL('/', site.url)} />
      <link rel="alternate" hreflang="en" href={new URL('/en/', site.url)} />
      <link rel="alternate" hreflang="x-default" href={new URL('/', site.url)} />
    </>}
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0A0A0C" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // .anima esconde lo que va a entrar con movimiento. Si el script de movimiento no llega a tiempo,
      // se retira sola y todo queda visible y quieto.
      (function (r) {
        r.classList.add('js', 'anima');
        setTimeout(function () { if (!r.dataset.movimiento) r.classList.remove('anima'); }, 2500);
      })(document.documentElement);
    </script>
  </head>
  <body>
    <slot />
    <script>import '../scripts/movimiento';</script>
  </body>
</html>
